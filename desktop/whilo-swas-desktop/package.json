{
  "name": "whilo-swas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Whilo desktop client for macOS, Windows and Linux",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.cjs && node --check src/preload.cjs",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.onerall.whilo",
    "productName": "Whilo",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "synopsis": "Whilo AI work operator",
      "description": "Whilo desktop client for agentic business workflows."
    }
  }
}
