{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html|whilo-auth.js|whilo-runtime.js|whilo-enterprise.js|whilo-agent-core.js|whilo-marketplace.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/affiliates",
      "destination": "/api/messages?route=affiliates"
    },
    {
      "source": "/api/account/bootstrap",
      "destination": "/api/messages?route=account-bootstrap"
    },
    {
      "source": "/api/marketplace/webhook",
      "destination": "/api/messages?route=marketplace-webhook"
    },
    {
      "source": "/api/marketplace",
      "destination": "/api/messages?route=marketplace"
    },
    {
      "source": "/api/messages/:route",
      "destination": "/api/messages?route=:route"
    },
    {
      "source": "/((?!assets/|pets/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
