# Configure in Vercel Project Settings > Environment Variables; keep all keys server-side.
WHILO_PUBLIC_URL=https://whilo-swas.vercel.app

# Supabase: set the project URL and public key; service-role key is server-only. On an existing deployment, verify migration history instead of replaying migrations.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate unique secrets; never put real values in Git.
# WHILO_CONNECTOR_ENCRYPTION_KEY must be base64 for exactly 32 random bytes.
WHILO_CONNECTOR_ENCRYPTION_KEY=
WHILO_OAUTH_STATE_SECRET=

# Create a Slack app and configure its Redirect URL to this exact callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://whilo-swas.vercel.app/api/connectors/slack/callback

# Set only for the one-time provisioning command; do not save this value in .env or Vercel.
# WHILO_OWNER_INITIAL_PASSWORD=
# WHILO_OWNER_EMAIL=ryantheirreal@gmail.com

# Marketplace / Stripe Connect — configure in Vercel only. Start with a dedicated sandbox; prefer a narrowly scoped rk_test_* restricted key where Stripe permissions allow.
STRIPE_SECRET_KEY=
# Use a separate test/sandbox key first; do not use a live key until all launch gates pass.
STRIPE_WEBHOOK_SECRET=
# Dedicated endpoint secret for /api/credits/webhook; can be the same secret only if Stripe is configured that way.
STRIPE_CREDITS_WEBHOOK_SECRET=
# Create recurring Stripe Prices and configure the provider Price IDs:
STRIPE_PRICE_WHILO_PLUS_MONTHLY=
STRIPE_PRICE_WHILO_PLUS_ANNUAL=
STRIPE_PRICE_WHILO_PREMIUM_MONTHLY=
STRIPE_PRICE_WHILO_PREMIUM_ANNUAL=
STRIPE_PRICE_WHILO_SUPER_MONTHLY=
STRIPE_PRICE_WHILO_SUPER_ANNUAL=
STRIPE_PRICE_WHILO_ULTRA_MONTHLY=
STRIPE_PRICE_WHILO_ULTRA_ANNUAL=
# Comma-separated Supabase Auth user UUIDs permitted to moderate listings; server-side only.
WHILO_MARKETPLACE_ADMIN_USER_IDS=

# Whilo Partners affiliate payouts — keep transfers disabled until Stripe sandbox tests pass.
WHILO_AFFILIATE_PAYOUT_ADMIN_USER_IDS=
WHILO_AFFILIATE_PAYOUTS_ENABLED=false


# Optional Sign in with ChatGPT (IDENTITY ONLY). Enable only after OpenAI approves Whilo's
# website OAuth integration and the exact callback URL is registered. Never use this to proxy
# ChatGPT consumer-plan inference from Whilo's hosted servers.
OPENAI_SIWC_ENABLED=false
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_CLIENT_SECRET=
OPENAI_SIWC_REDIRECT_URI=https://whilo-swas.vercel.app/api/auth/chatgpt/callback
# Random, independent 32+ byte signing secret. Server-side only; never expose to the browser.
WHILO_OPENAI_SESSION_SECRET=

# Google sign-in uses Supabase Auth's Google provider. Configure the Google client/secret in
# Supabase Auth settings and allow https://whilo-swas.vercel.app/ as a Supabase redirect URL.
# Google identity is not the same as Gemini Developer API authorization or a consumer Google AI plan.
